+echo "$ITS_DATA" > ${BINARIES_DIR}/wlsom1_secure.its
+
+cp ${BINARIES_DIR}/at91bootstrap.bin ${BINARIES_DIR}/boot.bin
+dd if=${BINARIES_DIR}/fde_key.bin of=${BINARIES_DIR}/boot.bin bs=1 conv=notrunc seek=$(($(stat --printf="%s" ${BINARIES_DIR}/boot.bin) - 512))
+
+veritysetup=${HOST_DIR}/sbin/veritysetup
+cryptsetup=${HOST_DIR}/sbin/cryptsetup
+mkfs=${HOST_DIR}/sbin/mkfs.ext4
+
+die() { echo "$@" >&2; exit 1; }
+
+test -x ${veritysetup} || \
+	die "No veritysetup found (host-cryptsetup has not been built?)"
+
+echo "# entering ${BINARIES_DIR} for this script"
+cd ${BINARIES_DIR}
+
+# Generate the hash table
+rm -f $rootfs.verity
+${veritysetup} format rootfs.ext4 rootfs.verity > rootfs.verity.header
+# Get the root hash
+ROOTHASH="$(awk '/Root hash:/ {print $3}' rootfs.verity.header)"
+
+echo ${ROOTHASH} | tr -d '\n' > roothash.txt
+# Sign the roothash
+if ! openssl smime -sign -nocerts -noattr -binary -in roothash.txt -inkey ${BINARIES_DIR}/verity_development_private.pem -signer ${BINARIES_DIR}/verity_development_cert.pem -outform der -out roothash.txt.signed; then
+    die "Failed to sign the root hash"
+fi
+
+# Encrypt the RFS
+# Create a 512M dummy file that will be mounted later as a encrypted RFS partition
+dd if=/dev/zero of=rfs.enc bs=1M count=512
+sync
+
+# Opening the file as an encrypted volume with they key specified is all that is needed
+sudo ${cryptsetup} -q -v --type plain --cipher aes-cbc-plain --key-file fde_key.bin open rfs.enc crypt
+# Copy the rfs image to create a encrypted rfs image
+sudo dd if=rootfs.ext4 of=/dev/mapper/crypt bs=4M
+sync
+# Lock and close
+sudo ${cryptsetup} close crypt
+
+# Create a 128M dummy file that will be mounted later as a persistent encrypted data partition
+dd if=/dev/zero of=userdata.enc bs=1M count=128
+sync
+# Opening the file as an encrypted volume with they key specified is all that is needed
+sudo ${cryptsetup} -q -v --type plain --cipher aes-cbc-plain --key-file fde_key.bin open userdata.enc crypt
+# Format the encrypted volume as a ext4 partition
+sudo ${mkfs} /dev/mapper/crypt
+# Lock and close
+sudo ${cryptsetup} close crypt
+sync
+
+#cp ${BINARIES_DIR}/image_signing.crt ${BINARIES_DIR}/samkey.crt
+#cp ${BINARIES_DIR}/image_signing.key ${BINARIES_DIR}/samkey.key
+
+mkimage -f ${BINARIES_DIR}/wlsom1_secure.its -r ${BINARIES_DIR}/wlsom1_secure.itb
diff --git a/board/microchip/sama5d27_wlsom1_ek/pre_build_genkeys.sh b/board/microchip/sama5d27_wlsom1_ek/pre_build_genkeys.sh
new file mode 100755
index 0000000..b22d739
--- /dev/null
+++ b/board/microchip/sama5d27_wlsom1_ek/pre_build_genkeys.sh
@@ -0,0 +1,11 @@
+# Create keys if not present
+# Key for signing dm-verity roothash
+if [ ! -f ${BINARIES_DIR}/verity_development_private.pem ]; then
+	mkdir -p ${BINARIES_DIR}
+	openssl genpkey -algorithm RSA -out ${BINARIES_DIR}/verity_development_private.pem -pkeyopt rsa_keygen_bits:2048
+	openssl req -x509 -newkey rsa:1024 -keyout ${BINARIES_DIR}/verity_development_private.pem -out ${BINARIES_DIR}/verity_development_cert.pem -nodes -days 365 -set_serial 01 -subj /CN=example.com
+fi
+# Key for RFS encryption
+if [ ! -f ${BINARIES_DIR}/fde_key.bin ]; then
+	dd if=/dev/random of=${BINARIES_DIR}/fde_key.bin bs=512 count=1
+fi
