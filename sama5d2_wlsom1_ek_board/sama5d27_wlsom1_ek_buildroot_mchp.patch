diff --git a/fs/cpio/init b/fs/cpio/init
index f74ef7e15f..300d2c6482 100755
--- a/fs/cpio/init
+++ b/fs/cpio/init
@@ -12,4 +12,75 @@ if (exec 0</dev/console) 2>/dev/null; then
     exec 2>/dev/console
 fi
 
-exec /sbin/init "$@"
+mkdir -p /sys
+mkdir -p /run
+mkdir -p /proc
+mount -t sysfs sys /sys
+mount -t tmpfs tmpfs /run
+mount -t proc proc /proc
+
+#Wait for the mmc device to enumerate
+echo "Waiting for mmc device..."
+count=0
+while [ $count -lt 25 ]; do
+    test -b /dev/mmcblk0p3 && break
+    sleep 0.1
+    count=`expr $count + 1`
+done
+
+mkdir -p /run/verity_data
+mount -o ro /dev/mmcblk0p3 /run/verity_data
+
+# Extract the fde_key_addr from the kernel command line
+FDE_KEY_ADDR=$(cat /proc/cmdline | sed -n 's/.*fde_key_addr=\([^ ]*\).*/\1/p')
+
+# Validate that the address was found
+if [ -z "$FDE_KEY_ADDR" ]; then
+    echo "Error: fde_key_addr not provided in kernel command line."
+    exit 1
+fi
+
+echo "Using FDE_KEY_ADDR: 0x$FDE_KEY_ADDR"
+
+dd if=/dev/mem bs=1 of=key.bin skip=$((0x$FDE_KEY_ADDR)) count=512
+
+echo -n
+echo "Opening dm-crypt rfs volume"
+cryptsetup -q -v --type plain --cipher aes-cbc-plain --key-size 256 --key-file key.bin open /dev/mmcblk0p2 enc_rfs
+
+echo "Opening verity volume"
+[ ! -f /run/verity_data/rootfs.verity ] && echo "Missing Merkle tree file" && exit 1
+[ ! -f /run/verity_data/roothash.txt ] && echo "Missing root hash file" && exit 1
+[ ! -f /run/verity_data/roothash.txt.signed ] && echo "Missing signed root hash" && exit 1
+
+veritysetup --restart-on-corruption --ignore-zero-blocks \
+    open /dev/mapper/enc_rfs verity /run/verity_data/rootfs.verity \
+    --root-hash-signature=/run/verity_data/roothash.txt.signed \
+    --root-hash-file=/run/verity_data/roothash.txt \
+    && echo "Verity setup succeeded" \
+    || {
+        echo "Verity verification failed..hanging"
+        journalctl --identifier=veritysetup || true
+        exit 1
+    }
+
+echo "Mounting verity volume"
+mkdir -p /newroot
+mount /dev/mapper/verity /newroot
+mount -t devtmpfs devtmpfs /newroot/dev
+mount -t tmpfs tmpfs /newroot/tmp
+
+echo "Opening dm-crypt userdata volume"
+cryptsetup -q -v --type plain --cipher aes-cbc-plain --key-size 256 --key-file key.bin open /dev/mmcblk0p4 enc_userdata
+echo "Mounting user data volume"
+mount /dev/mapper/enc_userdata /newroot/enc_userdata
+chown -R 0:0 /newroot/enc_userdata
+
+echo "Erasing key.bin from RAM..."
+dd if=/dev/zero of=key.bin bs=512 count=1
+rm key.bin
+
+echo "[Initramfs]: Switching root..."
+exec switch_root /newroot /sbin/init "$@"
+
+#exec /sbin/init "$@"
